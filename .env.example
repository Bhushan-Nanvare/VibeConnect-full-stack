# Copy this file to .env (same folder) and fill in your keys, then run:
#   docker compose up --build
# MongoDB, Redis, Inngest and the frontend URL are set inside docker-compose.yml.

# Any long random string, used to sign login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# --- ImageKit (required, the server will not start without these) ---
# https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Brevo SMTP (optional) ---
# Leave empty locally: verification and reset emails are printed in the server logs instead.
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
